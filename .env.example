# ==============================================================================
# CONTROLE DE JEJUM — VARIÁVEIS DE AMBIENTE
# ==============================================================================
# Copie este arquivo para .env e preencha com as credenciais do seu projeto Supabase.
# Obtenha os valores no dashboard do Supabase: Project Settings -> API.
#
# AVISO DE SEGURANÇA:
# - Utilize APENAS a chave pública/anon (Publishable / Anon key).
# - NUNCA utilize a chave de serviço (service_role) no frontend!
# ==============================================================================

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-aqui
